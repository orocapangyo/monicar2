<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>monicar2_teleop</name>
  <version>1.0.0</version>
  <description>
    Teleoperation node using keyboard for monicar2
  </description>

  <license>Apache 2.0</license>
  <url type="repository">https://github.com/orocapangyo/monicar2</url>
  <maintainer email="zeta0707@gmail.com">ChangWhan Lee</maintainer>
  <author email="zeta0707@gmail.com">ChangWhan Lee</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>joy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
